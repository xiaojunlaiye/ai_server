# Copy this file to .env and fill in your values

# Required
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: set a custom compatible base URL (e.g., proxy/gateway)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: comma separated list of origins for CORS
# e.g. http://localhost:3000,http://127.0.0.1:3000,http://10.0.2.2:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
